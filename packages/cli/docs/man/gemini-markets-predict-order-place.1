.SH NAME
.PP
gemini-markets-predict-order-place - Place a new prediction market order


.SH SYNOPSIS
.PP
\fBgemini-markets predict order place [flags]\fP


.SH DESCRIPTION
.PP
Place a new prediction market order.

.PP
Examples:
  gemini-markets predict order place --symbol NBA-LAL-BOS-2024 --side buy --outcome yes \\
    --type limit --quantity 100 --price 0.62

.PP
# With idempotency key (critical for agents)
  gemini-markets predict order place --symbol NBA-LAL-BOS-2024 --side buy --outcome yes \\
    --type limit --quantity 100 --price 0.62 --client-order-id "agent-12345"

.PP
# From stdin (flags override stdin values)
  echo '{"symbol":"GEMI-...","side":"buy","outcome":"yes","quantity":"100","price":"0.65"}' \\
    | gemini-markets predict order place --stdin

.PP
# Buy up to $50 worth of contracts including estimated prediction fees
  gemini-markets predict order place --symbol GEMI-... --side buy --outcome yes \\
    --dollars 50 --price 0.65

.PP
# Dry run (validate without placing)
  gemini-markets predict order place --symbol GEMI-... --side buy --outcome yes \\
    --quantity 100 --price 0.65 --dry-run -q


.SH OPTIONS
.PP
\fB--client-order-id\fP=""
	idempotency key (auto-generated if not provided)

.PP
\fB--dollars\fP=""
	dollar amount; buys cap spend including fees, sells target notional

.PP
\fB--dry-run\fP[=false]
	validate and show order parameters without placing

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for place

.PP
\fB--outcome\fP=""
	contract outcome: yes or no (required)

.PP
\fB--price\fP=""
	limit price

.PP
\fB--quantity\fP=""
	number of contracts (required unless --dollars)

.PP
\fB--side\fP=""
	order side: buy or sell (required)

.PP
\fB--stdin\fP[=false]
	read order parameters from stdin as JSON

.PP
\fB--stop-price\fP=""
	stop price

.PP
\fB--symbol\fP=""
	market symbol (required)

.PP
\fB--tif\fP="good-til-cancel"
	time-in-force: good-til-cancel, immediate-or-cancel, fill-or-kill, post-only

.PP
\fB--type\fP="limit"
	order type: limit, market


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--debug\fP[=false]
	enable debug logging

.PP
\fB--no-websocket\fP[=false]
	disable WebSocket and use REST API only

.PP
\fB-o\fP, \fB--output\fP="json"
	output format: json, table, or csv

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	suppress stderr output for pure JSON piping

.PP
\fB--raw\fP[=false]
	output compact JSON without pretty-printing

.PP
\fB--sandbox\fP[=false]
	use sandbox environment

.PP
\fB--timeout\fP=30
	request timeout in seconds

.PP
\fB--verbose\fP[=false]
	use full field names in JSON output (default: abbreviated)


