.SH NAME
.PP
gemini-markets-spot-order-place - Place a new spot order


.SH SYNOPSIS
.PP
\fBgemini-markets spot order place [flags]\fP


.SH DESCRIPTION
.PP
Place a new spot trading order.

.PP
Examples:
  # Market buy 0.1 BTC
  gemini-markets spot order place --symbol btcusd --side buy --type exchange market --amount 0.1

.PP
# Limit buy 0.5 ETH at $2000
  gemini-markets spot order place --symbol ethusd --side buy --type exchange limit \\
    --amount 0.5 --price 2000

.PP
# With idempotency key (critical for agents)
  gemini-markets spot order place --symbol btcusd --side buy --type exchange limit \\
    --amount 0.1 --price 50000 --client-order-id "agent-12345"

.PP
# Buy $50 worth of BTC (fee-adjusted)
  gemini-markets spot order place --symbol btcusd --side buy --dollars 50 --price 50000

.PP
# From stdin (flags override stdin values)
  echo '{"symbol":"btcusd","side":"buy","amount":"0.1","price":"50000"}' \\
    | gemini-markets spot order place --stdin

.PP
# Dry run (validate without placing)
  gemini-markets spot order place --symbol btcusd --side buy --amount 0.1 --price 50000 --dry-run -q


.SH OPTIONS
.PP
\fB--account\fP=""
	account name (optional)

.PP
\fB--amount\fP=""
	order amount in base currency (required unless --dollars)

.PP
\fB--client-order-id\fP=""
	idempotency key (auto-generated if not provided)

.PP
\fB--dollars\fP=""
	total dollar spend including fees (adjusts for fee tier)

.PP
\fB--dry-run\fP[=false]
	validate and show order parameters without placing

.PP
\fB--fok\fP[=false]
	fill-or-kill

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for place

.PP
\fB--ioc\fP[=false]
	immediate-or-cancel

.PP
\fB--maker-or-cancel\fP[=false]
	post-only order

.PP
\fB--price\fP=""
	limit price

.PP
\fB--side\fP=""
	order side: buy or sell (required)

.PP
\fB--stdin\fP[=false]
	read order parameters from stdin as JSON

.PP
\fB--stop-price\fP=""
	stop price for stop orders

.PP
\fB--symbol\fP=""
	trading pair symbol (required)

.PP
\fB--type\fP="exchange limit"
	order type: exchange limit, exchange market


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--debug\fP[=false]
	enable debug logging

.PP
\fB--no-websocket\fP[=false]
	disable WebSocket and use REST API only

.PP
\fB-o\fP, \fB--output\fP="json"
	output format: json, table, or csv

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	suppress stderr output for pure JSON piping

.PP
\fB--raw\fP[=false]
	output compact JSON without pretty-printing

.PP
\fB--sandbox\fP[=false]
	use sandbox environment

.PP
\fB--timeout\fP=30
	request timeout in seconds

.PP
\fB--verbose\fP[=false]
	use full field names in JSON output (default: abbreviated)


.SH EXAMPLE
.EX
  gemini-markets spot order place --symbol btcusd --side buy --amount 0.1 --price 50000
  gemini-markets spot order place --symbol btcusd --side buy --amount 0.1 --price 50000 --client-order-id agent-123
  gemini-markets spot order place --symbol btcusd --side buy --dollars 50 --price 50000 --dry-run -q
  echo '{"symbol":"btcusd","side":"buy","amount":"0.1","price":"50000"}' | gemini-markets spot order place --stdin -q
  gemini-markets --sandbox --no-websocket spot order place --symbol btcusd --side buy --amount 0.01 --price 50000 --client-order-id test-123 -q
.EE


